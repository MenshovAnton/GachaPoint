<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
             android:layout_width="match_parent"
             android:layout_height="match_parent"
             tools:context=".ui.fragment.home.HomeView" android:id="@+id/fl_home">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        tools:ignore="UselessParent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constrain_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/appTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:text="@string/app_name"
                android:textSize="30sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0" />

            <TextView
                android:id="@+id/appVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/app_version"
                android:textColor="@color/check"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.01"
                app:layout_constraintStart_toEndOf="@+id/appTitle"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/gameTypeChangerHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:padding="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/appVersion"
                app:layout_constraintTop_toTopOf="@+id/appTitle"
                app:layout_constraintVertical_bias="0.0" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/piggyBankWidgetHome"
                style="@style/Widget.GachaPoint.MaterialCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/appTitle"
                app:layout_constraintVertical_bias="0.0">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="15dp">

                    <TextView
                        android:id="@+id/titleGoalHome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_bank"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0.0" />

                    <TextView
                        android:id="@+id/piggyBankCounterHome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/wishIconHomeBank"
                        app:layout_constraintHorizontal_bias="1.0"
                        app:layout_constraintStart_toEndOf="@+id/titleGoalHome"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0.0"
                        tools:text="0/0" />

                    <ImageView
                        android:id="@+id/wishIconHomeBank"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:importantForAccessibility="no"
                        app:layout_constraintBottom_toBottomOf="@+id/piggyBankCounterHome"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="1.0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/piggyBankCounterHome"
                        app:srcCompat="@drawable/icon_intertwined_fate"
                        tools:ignore="ImageContrastCheck" />

                    <ProgressBar
                        android:id="@+id/piggyBankProgressHome"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="15dp"
                        android:layout_marginTop="10dp"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/progress_bar_layer"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/titleGoalHome"
                        app:layout_constraintVertical_bias="0.0" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/piggyBankWidgetHome"
                app:layout_constraintVertical_bias="0"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                style="@style/Widget.GachaPoint.MaterialCardView">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/statsHome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="15dp">

                    <TextView
                        android:id="@+id/statisticsHeaderHome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stat_header"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0.0" />

                    <GridLayout
                        android:id="@+id/statsTableHome"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginTop="10dp"
                        android:columnCount="4"
                        android:rowCount="3"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/statisticsHeaderHome"
                        app:layout_constraintVertical_bias="0">

                        <TextView
                            android:id="@+id/claimColumnHeaderHome"
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:layout_row="0"
                            android:layout_column="1"
                            android:gravity="center"
                            android:text="@string/claim_column_header" />

                        <TextView
                            android:id="@+id/missColumnHeaderHome"
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:layout_row="0"
                            android:layout_column="2"
                            android:gravity="center"
                            android:text="@string/miss_column_header"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.1"
                            app:layout_constraintStart_toEndOf="@+id/claimColumnHeaderHome"
                            app:layout_constraintTop_toBottomOf="@+id/statisticsHeaderHome"
                            app:layout_constraintVertical_bias="0.050000012"
                            tools:ignore="TextSizeCheck" />


                        <TextView
                            android:id="@+id/laterColumnHeaderHome"
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:layout_row="0"
                            android:layout_column="3"
                            android:gravity="center"
                            android:text="@string/later_column_header"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.2"
                            app:layout_constraintStart_toEndOf="@+id/missColumnHeaderHome"
                            app:layout_constraintTop_toBottomOf="@+id/statisticsHeaderHome"
                            app:layout_constraintVertical_bias="0.050000012"
                            tools:ignore="TextSizeCheck" />

                        <ImageView
                            android:id="@+id/gemIconHome"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_row="1"
                            android:layout_column="0"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/icon_primogem" />

                        <TextView
                            android:id="@+id/cliamsGemsCounterHome"
                            android:layout_row="1"
                            android:layout_column="1"
                            android:layout_gravity="center"
                            android:gravity="center"
                            tools:text="180" />

                        <TextView
                            android:id="@+id/missGemsCounterHome"
                            android:layout_row="1"
                            android:layout_column="2"
                            android:layout_gravity="center"
                            android:gravity="center"
                            tools:text="0" />

                        <TextView
                            android:id="@+id/laterGemsCounterHome"
                            android:layout_row="1"
                            android:layout_column="3"
                            android:layout_gravity="center"
                            android:gravity="center"
                            tools:text="2520" />

                        <ImageView
                            android:id="@+id/wishIconHome"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_row="2"
                            android:layout_column="0"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/icon_intertwined_fate" />

                        <TextView
                            android:id="@+id/claimWishesCounterHome"
                            android:layout_row="2"
                            android:layout_column="1"
                            android:layout_gravity="center"
                            android:gravity="center"
                            tools:text="1" />

                        <TextView
                            android:id="@+id/missWishesCounterHome"
                            android:layout_row="2"
                            android:layout_column="2"
                            android:layout_gravity="center"
                            android:gravity="center"
                            tools:text="0" />

                        <TextView
                            android:id="@+id/laterWishesCounterHome"
                            android:layout_row="2"
                            android:layout_column="3"
                            android:layout_gravity="center"
                            android:gravity="center"
                            tools:text="14" />

                    </GridLayout>

                    <TextView
                        android:id="@+id/subsCountHeaderHome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textSize="12sp"
                        android:textStyle="italic"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/statsTableHome"
                        app:layout_constraintVertical_bias="0"
                        tools:text="Number of moons:" />

                    <TextView
                        android:id="@+id/subsCountHome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:textSize="12sp"
                        android:textStyle="italic"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintStart_toEndOf="@+id/subsCountHeaderHome"
                        app:layout_constraintTop_toTopOf="@+id/subsCountHeaderHome"
                        app:layout_constraintVertical_bias="0"
                        tools:text="1" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</FrameLayout>