<resources>
    <style name="Splash.Theme.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Base.Theme.GachaPoint</item>
    </style>
    <style name="Base.Theme.GachaPoint" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:textColor">@color/black</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="fontFamily">@font/genshin_font</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="itemTextColor">@drawable/bottom_navigation_text_selector</item>
        <item name="itemIconTint">@drawable/bottom_navigation_selector</item>
        <item name="materialTimePickerTheme">@style/ThemeOverlay.GachaPoint.TimePicker</item>
        <item name="bottomNavigationStyle">@style/Navigation.GachaPoint.BottomNavBar</item>
        <item name="progressBarStyle">@style/ProgressBar.GachaPoint.ProgressBar</item>
        <item name="bottomSheetStyle">@style/CalendarMenu.GachaPoint.MenuSheet</item>
        <item name="android:trackTint">@color/light_grey</item>
    </style>
</resources>