<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NavMenuIndicator.GachaPoint.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/accent</item>
        <item name="android:width">56dp</item>
        <item name="android:height">32dp</item>
    </style>
    <style name="ThemeOverlay.GachaPoint.TimePicker" parent="ThemeOverlay.Material3.MaterialTimePicker">
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>
        <item name="colorSurfaceContainerHighest">@color/accent</item>
        <item name="colorPrimary">@color/check</item>
        <item name="colorPrimaryContainer">@color/check</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorOnSurfaceVariant">@color/grey</item>
        <item name="textAppearanceTitleLarge">@style/Typography.GachaPoint.TimePicker</item>
        <item name="textAppearanceTitleMedium">@style/Typography.GachaPoint.TimePicker</item>
        <item name="textAppearanceLabelLarge">@style/Typography.GachaPoint.TimePicker</item>
        <item name="textAppearanceLabelMedium">@style/Typography.GachaPoint.TimePicker</item>
        <item name="textAppearanceDisplayLarge">@style/Typography.GachaPoint.TimePickerNumbers</item>
        <item name="textAppearanceDisplayMedium">@style/Typography.GachaPoint.TimePickerNumbers</item>
        <item name="materialClockStyle">@style/TimePickerClock.GachaPoint.Clock</item>
        <item name="android:textColorHighlight">@color/check_30</item>
    </style>
    <style name="Typography.GachaPoint.TimePicker" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/genshin_font</item>
        <item name="android:fontFamily">@font/genshin_font</item>
    </style>
    <style name="Typography.GachaPoint.TimePickerNumbers" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="TimePickerClock.GachaPoint.Clock" parent="Widget.Material3.MaterialTimePicker.Clock">
        <item name="clockNumberTextColor">@color/white</item>
    </style>
    <style name="Navigation.GachaPoint.BottomNavBar" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/card_background_light</item>
        <item name="itemActiveIndicatorStyle">@style/NavMenuIndicator.GachaPoint.Indicator</item>
        <item name="itemPaddingTop">10dp</item>
        <item name="itemPaddingBottom">10dp</item>
    </style>
    <style name="Widget.GachaPoint.LinearProgressIndicator" parent="Widget.Material3.LinearProgressIndicator">
        <item name="indicatorColor">@color/accent</item>
        <item name="trackColor">#E0E0E0</item>
        <item name="trackThickness">14dp</item>
        <item name="trackCornerRadius">7dp</item>
    </style>
    <style name="Widget.GachaPoint.CircularProgressIndicator" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorColor">@color/contrast_wb_tint</item>
        <item name="trackThickness">4dp</item>
    </style>
    <style name="ThemeOverlay.GachaPoint.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="colorSurface">@color/card_background_light</item>
        <item name="colorSurfaceContainerLow">@color/card_background_light</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="bottomSheetStyle">@style/Widget.GachaPoint.BottomSheet.Modal</item>
    </style>
    <style name="Widget.GachaPoint.BottomSheet.Modal" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:maxWidth">@dimen/bottom_sheet_max_width</item>
    </style>
    <style name="ThemeOverlay.GachaPoint.NumberPicker" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorControlNormal">@color/accent</item>
        <item name="android:textColorPrimary">@color/black</item>
    </style>
    <style name="Dialog.GachaPoint.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurfaceContainerHigh">@color/card_background_light</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="android:textColorHighlight">@color/check_30</item>
    </style>
    <style name="DatePicker.GachaPoint.MaterialCalendar" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorSurfaceContainerHigh">@color/card_background_light</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorOnSurfaceVariant">@color/grey</item>
        <item name="android:textColorHighlight">@color/check_30</item>
    </style>
    <style name="DropDown.GachaPoint.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.GachaPoint.Pill</item>
        <item name="expandedHintEnabled">false</item>
        <item name="hintEnabled">false</item>
        <item name="boxCollapsedPaddingTop">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="boxStrokeColor">@color/dropdown_stroke_color</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="endIconTint">@color/accent</item>
    </style>
    <style name="ThemeOverlay.GachaPoint.DropdownMenu" parent="ThemeOverlay.Material3.AutoCompleteTextView.OutlinedBox">
        <item name="colorSurfaceContainerHigh">@color/card_background_light</item>
        <item name="colorSurfaceContainer">@color/card_background_light</item>
        <item name="colorSurface">@color/card_background_light</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorOnSurfaceVariant">@color/accent</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.GachaPoint.RoundedPopup</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.GachaPoint.RoundedPopup</item>
    </style>
    <style name="ShapeAppearance.GachaPoint.Pill" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">50%</item>
    </style>
    <style name="ShapeAppearance.GachaPoint.RoundedPopup" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">16dp</item>
    </style>
    <style name="Widget.GachaPoint.MaterialCardView" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/card_background_light</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="Switch.GachaPoint.MaterialSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/switch_thumb_selector</item>
        <item name="trackTint">@color/switch_track_selector</item>
        <item name="thumbIconTint">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="switchPadding">10dp</item>
    </style>
    <style name="Logo.GachaPoint.Hero" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">20dp</item>
        <item name="cornerFamily">rounded</item>
    </style>
    <style name="Avatar.GachaPoint.Image" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">24dp</item>
        <item name="cornerFamily">rounded</item>
    </style>
    <style name="TextAppearance.GachaPoint.Chip" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/genshin_font</item>
        <item name="android:fontFamily">@font/genshin_font</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="Chip.GachaPoint.Time" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/accent</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAppearance">@style/TextAppearance.GachaPoint.Chip</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/genshin_font</item>
        <item name="android:fontFamily">@font/genshin_font</item>
    </style>
    <style name="TextAppearance.GachaPoint.ChipFilter" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/genshin_font</item>
        <item name="android:fontFamily">@font/genshin_font</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/chip_filter_text_selector</item>
    </style>
    <style name="Chip.GachaPoint.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_filter_bg_selector</item>
        <item name="android:textColor">@color/chip_filter_text_selector</item>
        <item name="chipStrokeColor">@color/chip_filter_stroke_selector</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textAppearance">@style/TextAppearance.GachaPoint.ChipFilter</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/genshin_font</item>
        <item name="android:fontFamily">@font/genshin_font</item>
    </style>
    <style name="Button.GachaPoint.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/genshin_font</item>
        <item name="android:fontFamily">@font/genshin_font</item>
    </style>
    <style name="Button.GachaPoint.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/accent</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/accent</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/genshin_font</item>
        <item name="android:fontFamily">@font/genshin_font</item>
    </style>
    <style name="Widget.GachaPoint.BottomSheetCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/sheet_card_background</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardElevation">0dp</item>
    </style>
    <style name="Widget.GachaPoint.FAB" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/accent</item>
        <item name="tint">@color/white</item>
        <item name="elevation">4dp</item>
        <item name="hoveredFocusedTranslationZ">6dp</item>
        <item name="pressedTranslationZ">8dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
    </style>
</resources>