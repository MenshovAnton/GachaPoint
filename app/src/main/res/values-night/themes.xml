<resources>
    <style name="Splash.Theme.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background_night</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Base.Theme.GachaPoint</item>
    </style>
    <style name="Base.Theme.GachaPoint" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand / Identity -->
        <item name="fontFamily">@font/genshin_font</item>
        <item name="android:fontFamily">@font/genshin_font</item>

        <!-- Base Surface & Background (Deep Night) -->
        <item name="android:windowBackground">@color/background_night</item>
        <item name="android:textColor">@color/white</item>
        <item name="colorSurface">@color/background_night</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/dark_grey</item>
        <item name="colorOnSurfaceVariant">@color/white</item>
        <item name="colorSurfaceContainerLowest">@color/nav_bar_background_night</item>
        <item name="colorSurfaceContainerLow">@color/background_night</item>
        <item name="colorSurfaceContainer">@color/background_night</item>
        <item name="colorSurfaceContainerHigh">@color/dark_grey</item>
        <item name="colorSurfaceContainerHighest">@color/grey</item>

        <!-- Primary Accent -->
        <item name="colorPrimary">@color/check</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/accent</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <!-- Secondary & Tertiary -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/accent</item>
        <item name="colorOnSecondaryContainer">@color/white</item>

        <!-- Outline / Borders -->
        <item name="colorOutline">@color/check</item>
        <item name="colorOutlineVariant">@color/grey</item>

        <!-- Navigation Bar & Controls -->
        <item name="bottomNavigationStyle">@style/Navigation.GachaPoint.BottomNavBar</item>
        <item name="itemTextColor">@drawable/bottom_navigation_text_selector</item>
        <item name="itemIconTint">@drawable/bottom_navigation_selector</item>

        <!-- Component Themes -->
        <item name="materialTimePickerTheme">@style/ThemeOverlay.GachaPoint.TimePicker</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.GachaPoint.BottomSheetDialog</item>
        <item name="materialAlertDialogTheme">@style/Dialog.GachaPoint.AlertDialog</item>
        <item name="materialCalendarTheme">@style/DatePicker.GachaPoint.MaterialCalendar</item>
        <item name="linearProgressIndicatorStyle">@style/Widget.GachaPoint.LinearProgressIndicator</item>
        <item name="circularProgressIndicatorStyle">@style/Widget.GachaPoint.CircularProgressIndicator</item>
    </style>
</resources>