<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NavMenuIndicator.GachaPoint.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/accent</item>
    </style>
    <style name="ThemeOverlay.GachaPoint.TimePicker" parent="ThemeOverlay.Material3.MaterialTimePicker">
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorSurfaceContainerHigh">@color/background_night</item>
        <item name="colorSurfaceContainerHighest">@color/accent</item>
        <item name="colorPrimary">@color/check</item>
        <item name="colorPrimaryContainer">@color/accent</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnSurfaceVariant">@color/white</item>
        <item name="textAppearanceLabelLarge">@style/Typography.GachaPoint.TimePicker</item>
        <item name="textAppearanceLabelMedium">@style/Typography.GachaPoint.TimePicker</item>
        <item name="textAppearanceDisplayLarge">@style/Typography.GachaPoint.TimePicker</item>
        <item name="textAppearanceDisplayMedium">@style/Typography.GachaPoint.TimePicker</item>
        <item name="textAppearanceTitleMedium">@style/Typography.GachaPoint.TimePicker</item>
        <item name="materialClockStyle">@style/TimePickerClock.GachaPoint.Clock</item>
    </style>
    <style name="Typography.GachaPoint.TimePicker" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/genshin_font</item>
        <item name="android:fontFamily">@font/genshin_font</item>
    </style>
    <style name="TimePickerClock.GachaPoint.Clock" parent="Widget.Material3.MaterialTimePicker.Clock">
        <item name="clockNumberTextColor">@color/white</item>
    </style>
    <style name="Navigation.GachaPoint.BottomNavBar" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="backgroundTint">@color/nav_bar_background_night</item>
    </style>
    <style name="ProgressBar.GachaPoint.ProgressBar" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressTint">@color/accent</item>
        <item name="android:progressBackgroundTint">@color/white</item>
        <item name="android:minHeight">10dp</item>
    </style>
    <style name="CalendarMenu.GachaPoint.MenuSheet" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="android:textColor">@color/black</item>
    </style>
    <style name="Tabs.GachaPoint.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorColor">@color/check</item>
        <item name="tabIndicatorGravity">bottom</item>
        <item name="tabSelectedTextColor">@color/check</item>
        <item name="tabTextColor">@color/light_grey</item>
        <item name="android:textAllCaps">false</item>
        <item name="tabGravity">fill</item>
        <item name="tabIconTint">@color/check</item>
        <item name="tabRippleColor">@android:color/transparent</item>
    </style>
    <style name="Dialog.GachaPoint.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurfaceContainerHigh">@color/background_night</item>
        <item name="colorPrimary">@color/check</item>
        <item name="colorOnSurface">@color/white</item>
    </style>
    <style name="DatePicker.GachaPoint.MaterialCalendar" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorSurfaceContainerHigh">@color/background_night</item>
        <item name="colorPrimary">@color/check</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnSurfaceVariant">@color/light_grey</item>
    </style>
</resources>