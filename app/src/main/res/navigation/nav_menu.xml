<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_menu"
    app:startDestination="@+id/moreView">

    <fragment
        android:id="@+id/moreView"
        android:name="ru.menshovanton.gachapoint.ui.fragment.more.MoreView"
        android:label="@string/nav_menu"
        tools:layout="@layout/fragment_more">

        <action
            android:id="@+id/action_to_help"
            app:destination="@id/helpView"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out"/>

        <action
            android:id="@+id/action_to_info"
            app:destination="@id/infoView"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out"/>

        <action
            android:id="@+id/action_to_settings"
            app:destination="@id/settingsView"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out"/>

        <action
            android:id="@+id/action_to_feedback"
            app:destination="@id/feedbackView"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out"/>

        <action
            android:id="@+id/action_to_piggy_bank"
            app:destination="@id/piggyBankView"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out"/>

        <action
            android:id="@+id/action_to_statistics"
            app:destination="@id/statisticsView"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out"/>

        <action
            android:id="@+id/action_to_promocodes"
            app:destination="@id/promocodesView"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out"/>

        <action
            android:id="@+id/action_to_banners"
            app:destination="@id/bannersView"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out"/>

        <action
            android:id="@+id/action_to_donation"
            app:destination="@id/donationView"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out"/>

    </fragment>

    <fragment
        android:id="@+id/promocodesView"
        android:name="ru.menshovanton.gachapoint.ui.fragment.promocodes.PromocodesView"
        android:label="@string/menu_promo_title"
        tools:layout="@layout/fragment_promocodes" />

    <fragment
        android:id="@+id/bannersView"
        android:name="ru.menshovanton.gachapoint.ui.fragment.banners.BannersView"
        android:label="@string/banners_title"
        tools:layout="@layout/fragment_banners" />

    <fragment
        android:id="@+id/helpView"
        android:name="ru.menshovanton.gachapoint.ui.fragment.help.HelpView"
        android:label="@string/help_title"
        tools:layout="@layout/fragment_help" />

    <fragment
        android:id="@+id/piggyBankView"
        android:name="ru.menshovanton.gachapoint.ui.fragment.piggybank.PiggyBankView"
        android:label="@string/menu_savings_title"
        tools:layout="@layout/fragment_piggy_bank" />

    <fragment
        android:id="@+id/infoView"
        android:name="ru.menshovanton.gachapoint.ui.fragment.info.InfoView"
        android:label="@string/nav_info"
        tools:layout="@layout/fragment_info">

        <action
            android:id="@+id/action_info_to_donation"
            app:destination="@id/donationView"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out"/>

    </fragment>

    <fragment
        android:id="@+id/donationView"
        android:name="ru.menshovanton.gachapoint.ui.fragment.donation.DonationView"
        android:label="@string/nav_donation"
        tools:layout="@layout/fragment_donation" />

    <fragment
        android:id="@+id/settingsView"
        android:name="ru.menshovanton.gachapoint.ui.fragment.settings.SettingsView"
        android:label="@string/nav_settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/feedbackView"
        android:name="ru.menshovanton.gachapoint.ui.fragment.feedback.FeedbackView"
        android:label="@string/feedback"
        tools:layout="@layout/fragment_feedback" />

    <fragment
        android:id="@+id/statisticsView"
        android:name="ru.menshovanton.gachapoint.ui.fragment.statistics.StatisticsView"
        android:label="@string/stat_screen_title"
        tools:layout="@layout/fragment_statistics" />

</navigation>
