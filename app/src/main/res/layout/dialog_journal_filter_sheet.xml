<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="@dimen/sheet_drag_handle_width"
        android:layout_height="@dimen/sheet_drag_handle_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/sheet_drag_handle_margin_bottom"
        android:background="@drawable/sheet_drag_handle" />

    <TextView
        android:id="@+id/tv_sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFamily="@font/genshin_font"
        android:text="@string/journal_filter_sheet_title"
        android:textColor="@color/text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_sheet_section_rarity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/journal_filter_section_rarity"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/cg_sheet_rarity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:chipSpacingHorizontal="8dp"
        app:singleSelection="false">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_sheet_5star"
            style="@style/Chip.GachaPoint.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/journal_filter_5star" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_sheet_4star"
            style="@style/Chip.GachaPoint.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/journal_filter_4star" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_sheet_3star"
            style="@style/Chip.GachaPoint.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/journal_filter_3star" />
    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:id="@+id/tv_sheet_section_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/journal_filter_section_type"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/cg_sheet_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:chipSpacingHorizontal="8dp"
        app:singleSelection="false">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_sheet_characters"
            style="@style/Chip.GachaPoint.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/journal_filter_characters" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_sheet_weapons"
            style="@style/Chip.GachaPoint.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/journal_filter_weapons" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_sheet_bangboo"
            style="@style/Chip.GachaPoint.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="@string/journal_filter_bangboo" />
    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:id="@+id/tv_sheet_section_pity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/journal_filter_section_pity"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/cg_sheet_pity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:chipSpacingHorizontal="8dp"
        app:singleSelection="false">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_sheet_win_5050"
            style="@style/Chip.GachaPoint.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/journal_filter_win_5050" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_sheet_loss_5050"
            style="@style/Chip.GachaPoint.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/journal_filter_loss_5050" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_sheet_guaranteed"
            style="@style/Chip.GachaPoint.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/journal_filter_guaranteed" />
    </com.google.android.material.chip.ChipGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset_filters"
            style="@style/Button.GachaPoint.Outlined"
            android:layout_width="0dp"
            android:layout_height="@dimen/action_button_height"
            android:layout_weight="1"
            android:text="@string/journal_filter_reset" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_apply_filters"
            style="@style/Button.GachaPoint.Tonal"
            android:layout_width="0dp"
            android:layout_height="@dimen/action_button_height"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/journal_filter_apply" />
    </LinearLayout>

</LinearLayout>
