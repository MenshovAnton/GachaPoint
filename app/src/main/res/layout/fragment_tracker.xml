<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragment.tracker.TrackerView">

    <ScrollView
        android:id="@+id/sv_tracker_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        tools:ignore="UselessParent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/ll_month_nav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding_horizontal"
                android:layout_marginTop="@dimen/screen_padding_top"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toStartOf="@+id/ll_month_arrows"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tv_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/genshin_font"
                    android:includeFontPadding="false"
                    android:textColor="@color/text"
                    android:textSize="@dimen/text_size_screen_title"
                    android:textStyle="bold"
                    tools:text="Май" />

                <TextView
                    android:id="@+id/tv_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/genshin_font"
                    android:includeFontPadding="false"
                    android:textColor="@color/check"
                    android:textSize="@dimen/text_size_section_title"
                    android:textStyle="bold"
                    tools:text="2026" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_month_arrows"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/screen_padding_horizontal"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="@+id/ll_month_nav"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/ll_month_nav">

                <ImageButton
                    android:id="@+id/btn_prev_month"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/nav_prev_month"
                    android:src="@drawable/icon_left_arrow"
                    app:tint="@color/text" />

                <ImageButton
                    android:id="@+id/btn_next_month"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/nav_next_month"
                    android:src="@drawable/icon_right_arrow"
                    app:tint="@color/text" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_game_types"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/pills_padding_horizontal"
                android:paddingVertical="@dimen/pills_padding_vertical"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_pill"
                tools:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_month_nav" />

            <LinearLayout
                android:id="@+id/ll_mode_switcher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/card_margin_horizontal"
                android:layout_marginTop="@dimen/card_margin_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rv_game_types">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_mode_sub"
                    style="@style/Widget.GachaPoint.MaterialCardView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/check"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/iv_mode_sub_icon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/icon_subscription"
                            app:tint="@color/check" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_mode_sub_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/genshin_font"
                                android:text="@string/tracker_mode_sub"
                                android:textColor="@color/text"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_mode_sub_subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/genshin_font"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                tools:text="Активно: 1" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_mode_dailies"
                    style="@style/Widget.GachaPoint.MaterialCardView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/divider_color"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/iv_mode_dailies_icon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/icon_daily_task"
                            app:tint="@color/text_secondary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_mode_dailies_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/genshin_font"
                                android:text="@string/tracker_mode_dailies"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_mode_dailies_subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/genshin_font"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                tools:text="22 из 31 дн." />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_calendar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/card_margin_horizontal"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_mode_switcher">

                <GridLayout
                    android:id="@+id/gl_calendar_header"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:columnCount="7"
                    android:paddingVertical="6dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_column="0"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:text="@string/calendar_mon"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_column="1"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:text="@string/calendar_tue"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_column="2"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:text="@string/calendar_wed"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_column="3"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:text="@string/calendar_th"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_column="4"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:text="@string/calendar_fr"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_column="5"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:text="@string/calendar_sa"
                        android:textColor="#DD2C00"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_column="6"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:text="@string/calendar_su"
                        android:textColor="#DD2C00"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </GridLayout>

                <ru.menshovanton.gachapoint.ui.fragment.tracker.CalendarGrid
                    android:id="@+id/cg_calendar_grid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:columnCount="7"
                    android:rowCount="6"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/gl_calendar_header" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <FrameLayout
                android:id="@+id/fl_actions_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/card_margin_horizontal"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cl_calendar">

                <LinearLayout
                    android:id="@+id/ll_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_mark_today"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/min_touch_target_size"
                        android:layout_weight="1"
                        android:fontFamily="@font/genshin_font"
                        android:text="@string/btn_mark_sub"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/accent"
                        app:cornerRadius="12dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <ImageButton
                        android:id="@+id/btn_more"
                        android:layout_width="@dimen/icon_button_size"
                        android:layout_height="@dimen/icon_button_size"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/rounded_button"
                        android:contentDescription="@string/nav_menu"
                        android:src="@drawable/icon_more_menu"
                        app:tint="@color/white" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_selection_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_selection_mark"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/min_touch_target_size"
                        android:layout_weight="1"
                        android:fontFamily="@font/genshin_font"
                        android:text="@string/btn_selection_mark"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/accent"
                        app:cornerRadius="12dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_selection_unmark"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/min_touch_target_size"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/genshin_font"
                        android:text="@string/btn_selection_unmark"
                        android:textColor="@color/text"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <ImageButton
                        android:id="@+id/btn_select_all"
                        android:layout_width="@dimen/icon_button_size"
                        android:layout_height="@dimen/icon_button_size"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/rounded_button"
                        android:contentDescription="@string/select_all"
                        android:src="@drawable/icon_select_all"
                        app:tint="@color/white" />

                    <ImageButton
                        android:id="@+id/btn_close_selection"
                        android:layout_width="@dimen/icon_button_size"
                        android:layout_height="@dimen/icon_button_size"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/rounded_button"
                        android:contentDescription="@string/cancel"
                        android:src="@drawable/icon_cross"
                        app:tint="@color/white" />
                </LinearLayout>

            </FrameLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mcv_stats_card"
                style="@style/Widget.GachaPoint.MaterialCardView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/card_margin_horizontal"
                android:layout_marginTop="@dimen/card_margin_vertical"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/fl_actions_container">

                <LinearLayout
                    android:id="@+id/ll_tracker_sub_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="20dp"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <TextView
                        android:id="@+id/tv_tracker_sub_empty_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/genshin_font"
                        android:text="@string/tracker_sub_empty_title"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_tracker_sub_empty_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/tracker_sub_empty_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_tracker_add_sub_empty"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginTop="14dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="0dp"
                        android:text="@string/tracker_btn_add_sub"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        app:backgroundTint="@color/check"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/icon_plus"
                        app:iconPadding="4dp"
                        app:iconSize="14dp"
                        app:iconTint="@color/white" />

                </LinearLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_tracker_stats_active"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/card_inner_padding">

                    <TextView
                        android:id="@+id/tv_stats_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/genshin_font"
                        android:text="@string/stat_header_sub"
                        android:textColor="@color/text"
                        android:textSize="@dimen/text_size_section_title"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_received_column"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/claim_column_header"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@+id/tv_omitted_column"
                        app:layout_constraintStart_toEndOf="@+id/iv_gem"
                        app:layout_constraintTop_toBottomOf="@+id/tv_stats_header" />

                    <TextView
                        android:id="@+id/tv_omitted_column"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/miss_column_header"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@+id/tv_upcoming_column"
                        app:layout_constraintStart_toEndOf="@+id/tv_received_column"
                        app:layout_constraintTop_toTopOf="@+id/tv_received_column" />

                    <TextView
                        android:id="@+id/tv_upcoming_column"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/later_column_header"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tv_omitted_column"
                        app:layout_constraintTop_toTopOf="@+id/tv_received_column" />

                    <ImageView
                        android:id="@+id/iv_gem"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginTop="6dp"
                        android:importantForAccessibility="no"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_received_column"
                        app:srcCompat="@drawable/icon_primogem" />

                    <TextView
                        android:id="@+id/tv_received_gems"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_gem"
                        app:layout_constraintEnd_toEndOf="@+id/tv_received_column"
                        app:layout_constraintStart_toStartOf="@+id/tv_received_column"
                        app:layout_constraintTop_toTopOf="@+id/iv_gem"
                        tools:text="180" />

                    <TextView
                        android:id="@+id/tv_omitted_gems"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_gem"
                        app:layout_constraintEnd_toEndOf="@+id/tv_omitted_column"
                        app:layout_constraintStart_toStartOf="@+id/tv_omitted_column"
                        app:layout_constraintTop_toTopOf="@+id/iv_gem"
                        tools:text="0" />

                    <TextView
                        android:id="@+id/tv_upcoming_gems"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_gem"
                        app:layout_constraintEnd_toEndOf="@+id/tv_upcoming_column"
                        app:layout_constraintStart_toStartOf="@+id/tv_upcoming_column"
                        app:layout_constraintTop_toTopOf="@+id/iv_gem"
                        tools:text="2520" />

                    <ImageView
                        android:id="@+id/iv_pull"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginTop="6dp"
                        android:importantForAccessibility="no"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/iv_gem"
                        app:srcCompat="@drawable/icon_intertwined_fate" />

                    <TextView
                        android:id="@+id/tv_received_pulls"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_pull"
                        app:layout_constraintEnd_toEndOf="@+id/tv_received_column"
                        app:layout_constraintStart_toStartOf="@+id/tv_received_column"
                        app:layout_constraintTop_toTopOf="@+id/iv_pull"
                        tools:text="1" />

                    <TextView
                        android:id="@+id/tv_omitted_pulls"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_pull"
                        app:layout_constraintEnd_toEndOf="@+id/tv_omitted_column"
                        app:layout_constraintStart_toStartOf="@+id/tv_omitted_column"
                        app:layout_constraintTop_toTopOf="@+id/iv_pull"
                        tools:text="0" />

                    <TextView
                        android:id="@+id/tv_upcoming_pulls"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_pull"
                        app:layout_constraintEnd_toEndOf="@+id/tv_upcoming_column"
                        app:layout_constraintStart_toStartOf="@+id/tv_upcoming_column"
                        app:layout_constraintTop_toTopOf="@+id/iv_pull"
                        tools:text="14" />

                    <TextView
                        android:id="@+id/tv_sub_counter_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/genshin_font"
                        android:textColor="@color/text_secondary"
