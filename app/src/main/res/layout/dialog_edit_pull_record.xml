<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_dialog_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/genshin_font"
        android:text="@string/add_pull"
        android:textColor="@color/text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="@string/date">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/tiet_edit_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="false"
            android:importantForAutofill="no"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="@string/hint_input_content">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/tiet_drop_name_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="textPersonName" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/select_rare"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <RadioGroup
        android:id="@+id/rg_rarity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_three_star"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/three_star"
            app:buttonTint="@color/radio_button_selector" />

        <RadioButton
            android:id="@+id/rb_four_star"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/four_star"
            android:textColor="@color/rare_epic"
            app:buttonTint="@color/rare_epic" />

        <RadioButton
            android:id="@+id/rb_five_star"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/five_star"
            android:textColor="@color/rare_legendary"
            app:buttonTint="@color/rare_legendary" />
    </RadioGroup>

    <LinearLayout
        android:id="@+id/ll_pity_status_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/dialog_select_drop_outcome"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/rg_pity_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_pity_win"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pity_status_win"
                app:buttonTint="@color/radio_button_selector" />

            <RadioButton
                android:id="@+id/rb_pity_loss"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pity_status_loss"
                app:buttonTint="@color/radio_button_selector" />

            <RadioButton
                android:id="@+id/rb_pity_guaranteed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pity_status_guaranteed"
                app:buttonTint="@color/radio_button_selector" />
        </RadioGroup>
    </LinearLayout>

</LinearLayout>