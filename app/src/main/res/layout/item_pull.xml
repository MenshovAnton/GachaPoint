<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="6dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_pull"
        style="@style/Widget.GachaPoint.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="9dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/badge_pity_count"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                app:cardBackgroundColor="@color/pull_pity_badge_bg"
                app:cardCornerRadius="6dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tv_pity_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:minWidth="28dp"
                    android:paddingHorizontal="6dp"
                    android:fontFamily="@font/genshin_font"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    tools:text="59" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_avatar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                app:cardBackgroundColor="@color/badge_gold_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/rare_legendary"
                app:strokeWidth="1.5dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/badge_pity_count"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/iv_pull_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tv_avatar_letter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:fontFamily="@font/genshin_font"
                    android:textColor="@color/rare_legendary"
                    android:textSize="12sp"
                    tools:text="М" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/dropRare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/card_avatar"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="5★"
                tools:textColor="@color/rare_legendary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ll_date_container"
                app:layout_constraintStart_toEndOf="@+id/dropRare"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/dropType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:breakStrategy="high_quality"
                    android:hyphenationFrequency="normal"
                    android:fontFamily="@font/genshin_font"
                    android:textSize="13sp"
                    tools:text="Nilou"
                    tools:textColor="@color/text" />

                <TextView
                    android:id="@+id/tv_pull_outcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/genshin_font"
                    android:textSize="10sp"
                    android:visibility="gone"
                    tools:text="Won 50/50"
                    tools:textColor="@color/checked"
                    tools:visibility="visible"
                    tools:ignore="SmallSp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_date_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:gravity="end"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/iv_drag_handle"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/genshin_font"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    tools:text="30.08.2026" />

                <TextView
                    android:id="@+id/tv_pull_patch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/genshin_font"
                    app:fontFamily="@font/genshin_font"
                    android:textColor="@color/check"
                    android:textSize="10sp"
                    android:visibility="gone"
                    tools:text="Патч 5.0"
                    tools:visibility="visible" />
            </LinearLayout>


            <ImageView
                android:id="@+id/iv_drag_handle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="14dp"
                android:contentDescription="@null"
                android:padding="2dp"
                android:src="@drawable/icon_menu"
                android:visibility="gone"
                app:tint="@color/text_secondary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>