<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragment.more.MoreView">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="90dp"
        tools:ignore="UselessParent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_menu_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding_horizontal"
                android:layout_marginTop="@dimen/screen_padding_top"
                android:layout_marginEnd="@dimen/screen_padding_horizontal"
                android:fontFamily="@font/genshin_font"
                android:includeFontPadding="false"
                android:text="@string/nav_menu"
                android:textColor="@color/text"
                android:textSize="@dimen/text_size_screen_title"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_tools_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding_horizontal"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/genshin_font"
                android:text="@string/menu_section_tools"
                android:textColor="@color/check"
                android:textSize="@dimen/text_size_section_title"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_menu_header" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mcv_tools_card"
                style="@style/Widget.GachaPoint.MaterialCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/card_margin_horizontal"
                android:layout_marginTop="@dimen/card_margin_vertical"
                android:layout_marginEnd="@dimen/card_margin_horizontal"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_tools_header">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/row_savings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/badge_savings"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            app:cardBackgroundColor="@color/badge_gold_bg"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/icon_piggy_bank"
                                app:tint="@color/rare_legendary" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tv_savings_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_marginEnd="10dp"
                            android:text="@string/menu_savings_title"
                            android:textColor="@color/text"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@+id/iv_savings_arrow"
                            app:layout_constraintStart_toEndOf="@+id/badge_savings"
                            app:layout_constraintTop_toTopOf="@+id/badge_savings" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="10dp"
                            android:text="@string/menu_savings_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            app:layout_constraintEnd_toStartOf="@+id/iv_savings_arrow"
                            app:layout_constraintStart_toEndOf="@+id/badge_savings"
                            app:layout_constraintTop_toBottomOf="@+id/tv_savings_title" />

                        <ImageView
                            android:id="@+id/iv_savings_arrow"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/icon_right_arrow"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/text_secondary" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="70dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/divider_color" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/row_statistics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/badge_stats"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            app:cardBackgroundColor="@color/badge_blue_bg"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_bias="0.0"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/icon_statistics"
                                app:tint="@color/check" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tv_stats_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_marginEnd="10dp"
                            android:text="@string/menu_stats_title"
                            android:textColor="@color/text"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@+id/iv_stats_arrow"
                            app:layout_constraintStart_toEndOf="@+id/badge_stats"
                            app:layout_constraintTop_toTopOf="@+id/badge_stats" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="10dp"
                            android:text="@string/menu_stats_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            app:layout_constraintEnd_toStartOf="@+id/iv_stats_arrow"
                            app:layout_constraintStart_toEndOf="@+id/badge_stats"
                            app:layout_constraintTop_toBottomOf="@+id/tv_stats_title" />

                        <ImageView
                            android:id="@+id/iv_stats_arrow"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/icon_right_arrow"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/text_secondary" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="70dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/divider_color" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/row_calculator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/badge_calc"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            app:cardBackgroundColor="@color/badge_purple_bg"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_bias="0.0"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/icon_calculator"
                                app:tint="@color/rare_epic" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tv_calc_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_marginEnd="10dp"
                            android:text="@string/menu_calc_title"
                            android:textColor="@color/text"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@+id/pill_calc_soon"
                            app:layout_constraintStart_toEndOf="@+id/badge_calc"
                            app:layout_constraintTop_toTopOf="@+id/badge_calc" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="10dp"
                            android:text="@string/menu_calc_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            app:layout_constraintEnd_toStartOf="@+id/pill_calc_soon"
                            app:layout_constraintStart_toEndOf="@+id/badge_calc"
                            app:layout_constraintTop_toBottomOf="@+id/tv_calc_title" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/pill_calc_soon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/badge_blue_bg"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:strokeWidth="0dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="@string/menu_badge_soon"
                                android:textColor="@color/check"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                        </com.google.android.material.card.MaterialCardView>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="70dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/divider_color" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/row_promocodes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/badge_promo"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            app:cardBackgroundColor="@color/badge_green_bg"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_bias="0.0"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/icon_promocode"
                                app:tint="@color/checked" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tv_promo_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_marginEnd="10dp"
                            android:text="@string/menu_promo_title"
                            android:textColor="@color/text"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@+id/pill_promo_soon"
                            app:layout_constraintStart_toEndOf="@+id/badge_promo"
                            app:layout_constraintTop_toTopOf="@+id/badge_promo" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="10dp"
                            android:text="@string/menu_promo_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            app:layout_constraintEnd_toStartOf="@+id/pill_promo_soon"
                            app:layout_constraintStart_toEndOf="@+id/badge_promo"
                            app:layout_constraintTop_toBottomOf="@+id/tv_promo_title" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/pill_promo_soon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/badge_blue_bg"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:strokeWidth="0dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="@string/menu_badge_soon"
                                android:textColor="@color/check"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                        </com.google.android.material.card.MaterialCardView>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_app_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding_horizontal"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/genshin_font"
                android:text="@string/menu_section_app"
                android:textColor="@color/check"
                android:textSize="@dimen/text_size_section_title"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mcv_tools_card" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mcv_app_card"
                style="@style/Widget.GachaPoint.MaterialCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/card_margin_horizontal"
                android:layout_marginTop="@dimen/card_margin_vertical"
                android:layout_marginEnd="@dimen/card_margin_horizontal"
                android:layout_marginBottom="32dp"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_app_header"
                app:layout_constraintVertical_bias="0.0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/mcv_item_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/badge_settings"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            app:cardBackgroundColor="@color/badge_blue_bg"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_bias="0.0"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/icon_settings"
                                app:tint="@color/check" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tv_settings_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_marginEnd="10dp"
                            android:text="@string/nav_settings"
                            android:textColor="@color/text"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@+id/ic_settings_chevron"
                            app:layout_constraintStart_toEndOf="@+id/badge_settings"
                            app:layout_constraintTop_toTopOf="@+id/badge_settings" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="10dp"
                            android:text="@string/menu_settings_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            app:layout_constraintEnd_toStartOf="@+id/ic_settings_chevron"
                            app:layout_constraintStart_toEndOf="@+id/badge_settings"
                            app:layout_constraintTop_toBottomOf="@+id/tv_settings_title" />

                        <ImageView
                            android:id="@+id/ic_settings_chevron"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/icon_right_arrow"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/text_secondary" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="70dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/divider_color" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/mcv_item_feedback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/badge_feedback"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            app:cardBackgroundColor="@color/badge_blue_bg"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_bias="0.0"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/icon_feedback"
                                app:tint="@color/check" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tv_feedback_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_marginEnd="10dp"
                            android:text="@string/feedback"
                            android:textColor="@color/text"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@+id/ic_feedback_chevron"
                            app:layout_constraintStart_toEndOf="@+id/badge_feedback"
                            app:layout_constraintTop_toTopOf="@+id/badge_feedback" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="10dp"
                            android:text="@string/menu_feedback_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            app:layout_constraintEnd_toStartOf="@+id/ic_feedback_chevron"
                            app:layout_constraintStart_toEndOf="@+id/badge_feedback"
                            app:layout_constraintTop_toBottomOf="@+id/tv_feedback_title" />

                        <ImageView
                            android:id="@+id/ic_feedback_chevron"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/icon_right_arrow"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/text_secondary" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="70dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/divider_color" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/mcv_item_about"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/badge_about"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            app:cardBackgroundColor="@color/badge_blue_bg"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_bias="0.0"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/icon_about"
                                app:tint="@color/check" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tv_about_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_marginEnd="10dp"
                            android:text="@string/nav_info"
                            android:textColor="@color/text"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@+id/ic_about_chevron"
                            app:layout_constraintStart_toEndOf="@+id/badge_about"
