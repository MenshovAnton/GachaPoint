<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_promocodes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/screen_padding_top"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/min_touch_target_size"
            android:layout_height="@dimen/min_touch_target_size"
            android:background="@drawable/rounded_button"
            android:contentDescription="@string/a11y_btn_back"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/icon_left_arrow"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_title" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:fontFamily="@font/genshin_font"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/menu_promo_title"
            android:textColor="@color/text"
            android:textSize="@dimen/text_size_screen_title"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="@dimen/text_size_screen_title"
            app:autoSizeMinTextSize="18sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btn_back"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_game_types"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/pills_padding_horizontal"
        android:paddingVertical="@dimen/pills_padding_vertical"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@+id/header_promocodes"
        tools:listitem="@layout/item_pill"
        tools:orientation="horizontal" />

    <HorizontalScrollView
        android:id="@+id/scroll_filters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/card_margin_horizontal"
        android:paddingVertical="4dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@+id/rv_game_types">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_active"
                style="@style/Chip.GachaPoint.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/promocode_filter_active" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_with_gems"
                style="@style/Chip.GachaPoint.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/promocode_filter_with_gems" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_no_gems"
                style="@style/Chip.GachaPoint.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/promocode_filter_no_gems" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_stream"
                style="@style/Chip.GachaPoint.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/promocode_filter_stream" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_permanent"
                style="@style/Chip.GachaPoint.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/promocode_filter_permanent" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_expired"
                style="@style/Chip.GachaPoint.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/promocode_filter_expired" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_all"
                style="@style/Chip.GachaPoint.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/promocode_filter_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_redeemed"
                style="@style/Chip.GachaPoint.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/promocode_filter_redeemed" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <include
        layout="@layout/include_offline_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/card_margin_horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintTop_toBottomOf="@+id/scroll_filters" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/srl_promocodes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_offline_notice">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_promocodes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/card_margin_horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="@dimen/screen_padding_bottom"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <LinearLayout
        android:id="@+id/ll_empty_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_offline_notice"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/iv_empty_promocodes"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_empty_promocodes" />

        <TextView
            android:id="@+id/tv_empty_promocodes_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/genshin_font"
            android:gravity="center"
            android:text="@string/promocodes_empty_title"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_empty_promocodes_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/promocodes_empty_desc"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_empty_promo_reset"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:minHeight="0dp"
            android:paddingHorizontal="18dp"
            android:paddingVertical="0dp"
            android:text="@string/promocodes_empty_reset_filter"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:visibility="gone"
            app:backgroundTint="@color/check"
            app:cornerRadius="12dp"
            tools:visibility="visible" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>