<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_chip"
    android:layout_width="wrap_content"
    android:layout_height="38dp"
    android:layout_marginEnd="8dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/pull_row_bg"
    app:cardCornerRadius="19dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/pull_row_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="12dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_chip_avatar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/pull_row_stroke">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/tv_chip_letter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:fontFamily="@font/genshin_font"
                    android:textSize="12sp"
                    android:textColor="@color/text"
                    tools:text="С" />

                <ImageView
                    android:id="@+id/iv_chip_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@null"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_chip_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/genshin_font"
            android:includeFontPadding="false"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Скирк" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
