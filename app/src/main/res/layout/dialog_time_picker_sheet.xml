<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="@dimen/sheet_drag_handle_width"
        android:layout_height="@dimen/sheet_drag_handle_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/sheet_drag_handle_margin_bottom"
        android:background="@drawable/sheet_drag_handle" />

    <TextView
        android:id="@+id/tv_time_sheet_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="@font/genshin_font"
        android:text="@string/time_picker_title"
        android:textColor="@color/text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.GachaPoint.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp">

            <NumberPicker
                android:id="@+id/np_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:descendantFocusability="blocksDescendants"
                android:selectionDividerHeight="0dp"
                android:theme="@style/ThemeOverlay.GachaPoint.NumberPicker"
                tools:targetApi="q" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:fontFamily="sans-serif-medium"
                android:text=":"
                android:textColor="@color/check"
                android:textSize="28sp"
                android:textStyle="bold" />

            <NumberPicker
                android:id="@+id/np_minutes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:descendantFocusability="blocksDescendants"
                android:selectionDividerHeight="0dp"
                android:theme="@style/ThemeOverlay.GachaPoint.NumberPicker"
                tools:targetApi="q" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save_time"
        style="@style/Button.GachaPoint.Tonal"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-medium"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/time_picker_save"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:backgroundTint="@color/accent"
        app:cornerRadius="14dp" />

</LinearLayout>