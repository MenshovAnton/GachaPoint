<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    tools:context=".ui.fragment.journal.JournalView">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_journal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_scrollFlags="scroll">

            <TextView
                android:id="@+id/tv_journal_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding_horizontal"
                android:layout_marginTop="@dimen/screen_padding_top"
                android:fontFamily="@font/genshin_font"
                android:includeFontPadding="false"
                android:text="@string/nav_journal"
                android:textColor="@color/text"
                android:textSize="@dimen/text_size_screen_title"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_game_types"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/pills_padding_horizontal"
                android:paddingVertical="@dimen/pills_padding_vertical"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_pill"
                tools:orientation="horizontal" />

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_banner_dashboard"
            style="@style/Widget.GachaPoint.MaterialCardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/card_margin_horizontal"
            android:layout_marginTop="@dimen/card_margin_vertical"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_inner_padding">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_banner_selector"
                        style="@style/DropDown.GachaPoint.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:saveEnabled="false"
                        android:theme="@style/ThemeOverlay.GachaPoint.DropdownMenu">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/mac_banner_selector"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:dropDownVerticalOffset="4dp"
                            android:fontFamily="@font/genshin_font"
                            android:freezesText="false"
                            android:gravity="center_vertical"
                            android:includeFontPadding="false"
                            android:inputType="none"
                            android:minHeight="0dp"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="0dp"
                            android:popupBackground="@drawable/bg_dropdown_popup"
                            android:saveEnabled="false"
                            android:textColor="@color/dropdown_text_selector"
                            android:textSize="14sp"
                            tools:ignore="LabelFor" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:id="@+id/ll_selection_bar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageButton
                            android:id="@+id/btn_cancel_selection"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/a11y_btn_close"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/icon_cross"
                            app:tint="@color/text" />

                        <TextView
                            android:id="@+id/tv_selection_count"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/text"
                            android:textSize="15sp"
                            tools:text="Selected: 3" />

                        <ImageButton
                            android:id="@+id/btn_select_all"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/select_all"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/icon_select_all"
                            app:tint="@color/text" />

                        <ImageButton
                            android:id="@+id/btn_delete_selected"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/delete"
                            android:padding="8dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/icon_delete"
                            app:tint="@color/missed" />
                    </LinearLayout>
                </FrameLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/divider_color" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tv_label_5star"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pity_5star_title"
                            android:textColor="@color/rare_legendary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/badge_pity_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            app:cardBackgroundColor="@color/badge_gold_bg"
                            app:cardCornerRadius="6dp"
                            app:cardElevation="0dp"
                            app:layout_constrainedWidth="true"
                            app:layout_constraintBottom_toBottomOf="@+id/tv_label_5star"
                            app:layout_constraintEnd_toStartOf="@+id/tv_pity_5star_counter"
                            app:layout_constraintHorizontal_bias="0.0"
                            app:layout_constraintStart_toEndOf="@+id/tv_label_5star"
                            app:layout_constraintTop_toTopOf="@+id/tv_label_5star"
                            app:strokeWidth="0dp">

                            <TextView
                                android:id="@+id/tv_pity_status_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:textColor="@color/rare_legendary"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                tools:text="50/50 Chance"
                                tools:ignore="SmallSp" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tv_pity_5star_counter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/text"
                            android:textSize="14sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="45 / 90" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_pity_5star"
                            style="@style/Widget.GachaPoint.LinearProgressIndicator"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            app:indicatorColor="@color/rare_legendary"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tv_label_5star"
                            app:trackColor="@color/divider_color"
                            app:trackThickness="8dp"
                            tools:progress="50" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">

                        <TextView
                            android:id="@+id/tv_label_4star"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pity_4star_title"
                            android:textColor="@color/rare_epic"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tv_pity_4star_counter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/text"
                            android:textSize="14sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="7 / 10" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_pity_4star"
                            style="@style/Widget.GachaPoint.LinearProgressIndicator"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            app:indicatorColor="@color/rare_epic"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tv_label_4star"
                            app:trackColor="@color/divider_color"
                            app:trackThickness="8dp"
                            tools:progress="70" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/card_margin_horizontal"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/check"
            app:trackColor="@android:color/transparent"
            app:trackThickness="3dp" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_pulls_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/screen_padding_horizontal"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/item_pull"
        tools:visibility="visible" />

    <FrameLayout
        android:id="@+id/ll_empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/ll_empty_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="28dp"
            android:gravity="center"
            android:orientation="vertical"
            tools:ignore="UselessParent">

            <ImageView
                android:id="@+id/iv_empty_journal"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_empty_journal" />

            <TextView
                android:id="@+id/tv_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/genshin_font"
                android:text="@string/empty_journal_title"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_empty_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/empty_journal_desc"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_empty_add_one"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="0dp"
                    android:text="@string/empty_journal_add_one"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    app:backgroundTint="@color/check"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/icon_plus"
                    app:iconPadding="6dp"
                    app:iconSize="14dp"
                    app:iconTint="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_empty_add_ten"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="0dp"
                    android:text="@string/empty_journal_add_ten"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    app:backgroundTint="@color/check"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/icon_plus"
                    app:iconPadding="6dp"
                    app:iconSize="14dp"
                    app:iconTint="@color/white" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_scroll_top"
        style="@style/Widget.GachaPoint.FAB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/screen_padding_horizontal"
        android:layout_marginBottom="92dp"
        android:contentDescription="@string/scroll_to_top"
        android:visibility="gone"
        app:fabSize="normal"
        app:srcCompat="@drawable/icon_arrow_up"
        tools:visibility="visible" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_add"
        style="@style/Widget.GachaPoint.FAB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/screen_padding_horizontal"
        android:layout_marginBottom="@dimen/screen_padding_bottom"
        android:contentDescription="@string/add_pull"
        app:fabSize="normal"
        app:srcCompat="@drawable/icon_plus" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>