<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragment.help.HelpView">

    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="@dimen/min_touch_target_size"
        android:layout_height="@dimen/min_touch_target_size"
        android:layout_marginStart="@dimen/screen_padding_horizontal"
        android:background="@drawable/rounded_button"
        android:contentDescription="@string/a11y_btn_back"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/icon_left_arrow"
        app:layout_constraintBottom_toBottomOf="@+id/tv_help_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_help_header" />

    <TextView
        android:id="@+id/tv_help_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="@dimen/screen_padding_top"
        android:layout_marginEnd="@dimen/screen_padding_horizontal"
        android:fontFamily="@font/genshin_font"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/help_title"
        android:textColor="@color/text"
        android:textSize="@dimen/text_size_screen_title"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="@dimen/text_size_screen_title"
        app:autoSizeMinTextSize="18sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_back"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_help_sections"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingBottom="90dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_help_header"
        tools:listitem="@layout/item_help_section" />

</androidx.constraintlayout.widget.ConstraintLayout>
