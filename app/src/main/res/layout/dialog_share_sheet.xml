<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="@dimen/sheet_drag_handle_width"
        android:layout_height="@dimen/sheet_drag_handle_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/sheet_drag_handle_margin_bottom"
        android:background="@drawable/sheet_drag_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="14dp"
        android:fontFamily="@font/genshin_font"
        android:text="@string/stat_share_sheet_title"
        android:textColor="@color/text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.GachaPoint.BottomSheetCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/row_share_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/badge_share_send"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardBackgroundColor="@color/badge_blue_bg"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.0"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/icon_share"
                        app:tint="@color/check" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tv_title_share_send"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="@font/genshin_font"
                    android:text="@string/stat_share_sheet_send"
                    android:textColor="@color/text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/iv_arrow_send"
                    app:layout_constraintStart_toEndOf="@+id/badge_share_send"
                    app:layout_constraintTop_toTopOf="@+id/badge_share_send" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="@font/genshin_font"
                    android:text="@string/stat_share_sheet_send_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toStartOf="@+id/iv_arrow_send"
                    app:layout_constraintStart_toEndOf="@+id/badge_share_send"
                    app:layout_constraintTop_toBottomOf="@+id/tv_title_share_send" />

                <ImageView
                    android:id="@+id/iv_arrow_send"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/icon_right_arrow"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/text_secondary" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="70dp"
                android:layout_marginEnd="16dp"
                android:background="@color/divider_color" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/row_share_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/badge_share_save"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardBackgroundColor="@color/badge_green_bg"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/icon_download"
                        app:tint="@color/checked" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tv_title_share_save"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="@font/genshin_font"
                    android:text="@string/stat_share_sheet_save"
                    android:textColor="@color/text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/iv_arrow_save"
                    app:layout_constraintStart_toEndOf="@+id/badge_share_save"
                    app:layout_constraintTop_toTopOf="@+id/badge_share_save" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="@font/genshin_font"
                    android:text="@string/stat_share_sheet_save_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toStartOf="@+id/iv_arrow_save"
                    app:layout_constraintStart_toEndOf="@+id/badge_share_save"
                    app:layout_constraintTop_toBottomOf="@+id/tv_title_share_save" />

                <ImageView
                    android:id="@+id/iv_arrow_save"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/icon_right_arrow"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/text_secondary" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
