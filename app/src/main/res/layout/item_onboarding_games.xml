                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="10dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/games_make_default"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_star_rounded"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/mcv_check_hsr"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/text_secondary" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/mcv_check_hsr"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        app:cardBackgroundColor="@color/check"
                        app:cardCornerRadius="13dp"
                        app:cardElevation="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:strokeColor="@color/pull_row_stroke"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/iv_check_hsr"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/icon_check"
                            app:tint="@color/white" />

                    </com.google.android.material.card.MaterialCardView>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

