<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_dialog_currency"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:importantForAccessibility="no"
            android:src="@drawable/icon_primogem" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/genshin_font"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Благословение полой луны" />

            <TextView
                android:id="@+id/tv_dialog_game"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/genshin_font"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="Genshin Impact" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_dialog_chain_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/genshin_font"
        android:textColor="@color/check"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="Текущая цепочка: 1 из 6" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/genshin_font"
        android:text="@string/dialog_add_sub_count_label"
        android:textColor="@color/text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_1"
            style="@style/Chip.GachaPoint.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/plus_thirty_days" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_2"
            style="@style/Chip.GachaPoint.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/plus_sixty_days" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_3"
            style="@style/Chip.GachaPoint.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/plus_ninty_days" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_4"
            style="@style/Chip.GachaPoint.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/plus_one_hundred_twenty_days" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_5"
            style="@style/Chip.GachaPoint.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/plus_one_hundred_fifty_days" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_6"
            style="@style/Chip.GachaPoint.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/plus_one_hundred_eighty_days" />
    </com.google.android.material.chip.ChipGroup>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.GachaPoint.BottomSheetCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_preview_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/genshin_font"
                android:textColor="@color/text"
                android:textSize="13sp"
                tools:text="Срок: +30 дней" />

            <TextView
                android:id="@+id/tv_preview_reward"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/genshin_font"
                android:textColor="@color/checked"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Награда: +2 700 гемов (~16 круток)" />

            <TextView
                android:id="@+id/tv_preview_start_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/genshin_font"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="Дата начала: 13 октября 2026" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_add_sub"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/genshin_font"
            android:text="@string/cancel"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_add_sub"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/genshin_font"
            android:text="@string/dialog_add_sub_confirm"
            android:textColor="@color/white"
            app:backgroundTint="@color/check" />
    </LinearLayout>

</LinearLayout>
